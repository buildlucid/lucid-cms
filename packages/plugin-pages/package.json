{
	"name": "@lucidcms/pages",
	"version": "0.19.0-alpha.0",
	"description": "The official Pages plugin for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./translations": "./translations",
		"./components": {
			"types": "./dist/admin/components.d.mts",
			"default": "./src/admin/components/index.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --noEmit && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist",
		"translations",
		"src",
		"!src/**/*.test.*"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-pages"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Pages",
		"Plugin",
		"Slug"
	],
	"devDependencies": {
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"zod": "^4.6.6",
		"@lucidcms/admin": "0.19.0-alpha.0",
		"solid-js": "^1.9.18",
		"@tanstack/solid-query": "^5.105.0"
	},
	"peerDependencies": {
		"@lucidcms/core": "0.19.0-alpha.0",
		"@lucidcms/admin": "0.19.0-alpha.0",
		"solid-js": "^1.9.13",
		"@tanstack/solid-query": "^5.101.1"
	},
	"dependencies": {
		"immer": "^11.2.9",
		"kysely": "0.29.7",
		"solid-icons": "^1.2.0"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": ">=24"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
