{
	"name": "@lucidcms/plugin-site",
	"version": "0.0.0",
	"private": true,
	"description": "The official site plugin for Lucid CMS. Renders your website from Kiln templates.",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./cli": {
			"types": "./dist/cli.d.mts",
			"import": "./dist/cli.mjs"
		},
		"./ui": {
			"types": "./dist/ui.d.mts",
			"import": "./dist/ui.mjs"
		},
		"./client/lucid.js": "./dist/client/lucid.js",
		"./client/component.js": "./dist/client/component.js"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch",
		"format": "biome format ./src",
		"format:fix": "biome format --write ./src",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-site"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Site",
		"Kiln",
		"Plugin"
	],
	"dependencies": {
		"@lucidcms/client": "^0.5.0",
		"@lucidcms/rich-text": "^1.2.0",
		"@lucidkiln/core": "^1.7.1",
		"hono": "^4.13.14",
		"rou3": "^1.0.0",
		"unrouting": "^0.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@lucidcms/core": "0.19.0-alpha.0",
		"@lucidcms/preview-protocol": "*",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0",
		"vite": "^8.3.5"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT"
}
