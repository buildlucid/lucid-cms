{
	"name": "@lucidcms/plugin-site",
	"version": "0.0.0",
	"private": true,
	"description": "The official site plugin for Lucid CMS. Renders your website from Kiln templates.",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./cli": {
			"types": "./dist/cli.d.mts",
			"import": "./dist/cli.mjs"
		},
		"./ui": {
			"types": "./dist/ui.d.mts",
			"import": "./dist/ui.mjs"
		},
		"./translations": "./translations",
		"./components": {
			"types": "./dist/admin/components.d.mts",
			"default": "./src/admin/components/index.ts"
		},
		"./client/lucid.js": "./dist/client/lucid.js",
		"./client/component.js": "./dist/client/component.js"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist",
		"translations",
		"src/admin",
		"!src/**/*.test.*"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-site"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Site",
		"Kiln",
		"Plugin"
	],
	"dependencies": {
		"@lucidcms/client": "^0.5.0",
		"@lucidcms/rich-text": "^1.2.0",
		"@lucidkiln/core": "^1.7.1",
		"hono": "^4.13.14",
		"rou3": "^1.0.0",
		"unrouting": "^0.3.1"
	},
	"devDependencies": {
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"@lucidcms/admin": "0.19.0-alpha.0",
		"@tanstack/solid-query": "^5.105.0",
		"solid-js": "^1.9.18"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0",
		"vite": "^8.3.5",
		"@lucidcms/admin": "^0.19.0-alpha.0",
		"@tanstack/solid-query": "^5.101.1",
		"solid-js": "^1.9.13"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT"
}
