{
	"name": "@lucidcms/admin",
	"version": "0.19.0-alpha.0",
	"description": "The admin SolidJS SPA for Lucid CMS.",
	"private": false,
	"type": "module",
	"files": [
		"dist",
		"src",
		"!src/build",
		"!src/**/*.test.*"
	],
	"exports": {
		"./build": {
			"types": "./dist/build/index.d.mts",
			"default": "./dist/build/index.mjs"
		},
		"./package.json": "./package.json",
		"./theme.css": "./src/exports/theme.css",
		"./types": {
			"types": "./dist/types/types.d.mts"
		},
		"./config": {
			"types": "./dist/config/config.d.mts",
			"default": "./dist/config/config.mjs"
		},
		"./components": {
			"types": "./dist/browser/components.d.mts",
			"default": "./src/exports/components.ts"
		},
		"./hooks": {
			"types": "./dist/browser/hooks.d.mts",
			"default": "./src/exports/hooks.ts"
		},
		"./services": {
			"types": "./dist/browser/services.d.mts",
			"default": "./src/exports/services.ts"
		},
		"./utils": {
			"types": "./dist/browser/utils.d.mts",
			"default": "./src/exports/utils.ts"
		}
	},
	"scripts": {
		"build": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit && tsdown",
		"dev": "tsdown --watch"
	},
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/admin"
	},
	"keywords": [
		"CMS",
		"Headless",
		"SolidJS",
		"Typescript",
		"Lucid CMS",
		"Lucid"
	],
	"license": "MIT",
	"devDependencies": {
		"@lucidcms/preview-protocol": "*",
		"@types/classnames": "^2.3.4",
		"@types/node": "^24.19.2",
		"@types/object-hash": "^3.0.6",
		"happy-dom": "^21.0.4",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-sass": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@kobalte/core": "^0.13.14",
		"@lezer/highlight": "^1.2.5",
		"@lucidcms/rich-text": "1.2.0",
		"@lucidcms/types": "^0.6.0",
		"@solid-primitives/scheduled": "^1.5.3",
		"@solidjs/router": "^1.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/solid-query": "^5.105.0",
		"@thisbeyond/solid-dnd": "^0.7.5",
		"@tiptap/core": "^3.32.2",
		"@tiptap/extensions": "^3.32.2",
		"@tiptap/markdown": "^3.32.2",
		"@tiptap/pm": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"@tiptap/suggestion": "^3.32.2",
		"blurhash": "^2.0.5",
		"chart.js": "^4.6.1",
		"classnames": "^2.5.1",
		"codemirror": "^6.0.2",
		"cropperjs": "^2.3.1",
		"dompurify": "^3.4.17",
		"eventsource-parser": "^4.1.3",
		"fast-average-color": "^9.6.0",
		"fast-deep-equal": "^3.1.3",
		"i18next": "^26.5.12",
		"marked": "^18.1.2",
		"nanoid": "^6.0.2",
		"object-hash": "^3.0.0",
		"solid-codemirror": "^2.3.3",
		"solid-icons": "^1.2.0",
		"solid-js": "^1.9.18",
		"solid-tiptap": "^0.9.0",
		"solid-toast": "^0.5.0",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.5",
		"vite-plugin-solid": "^2.11.15"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
