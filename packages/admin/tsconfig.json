{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["vite/client"],
		"noEmit": true,
		"isolatedModules": true,
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"paths": {
			"@lucidcms/admin/types": ["src/exports/types.ts"],
			"@lucidcms/admin/config": ["src/exports/config.ts"],
			"@match-permissions": [
				"../core/src/libs/permission/match-permissions.ts"
			],
			"@/*": ["src/*"],
			"@types": ["../core/src/exports/types.ts"],
			"@field-conditions": [
				"../core/src/libs/collection/custom-fields/conditions/index.ts"
			],
			"@field-capabilities": [
				"../core/src/libs/collection/custom-fields/capabilities.ts"
			],
			"@assets/*": ["src/assets/*"],
			"@lucidcms/admin/hooks": ["src/exports/hooks.ts"],
			"@lucidcms/admin/services": ["src/exports/services.ts"],
			"@lucidcms/admin/utils": ["src/exports/utils.ts"]
		}
	}
}
