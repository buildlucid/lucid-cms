{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["vite/client"],
		"noEmit": true,
		"isolatedModules": true,
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"paths": {
			"@lucidcms/admin/types": ["src/exports/types.ts"],
			"@lucidcms/admin/slots": ["src/exports/slots.ts"],
			"@/*": ["src/*"],
			"@types": ["../core/src/exports/types.ts"],
			"@field-conditions": [
				"../core/src/libs/collection/custom-fields/conditions/index.ts"
			],
			"@field-capabilities": [
				"../core/src/libs/collection/custom-fields/capabilities.ts"
			],
			"@assets/*": ["src/assets/*"]
		}
	}
}
