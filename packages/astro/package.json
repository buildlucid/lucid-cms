{
	"name": "@lucidcms/astro",
	"version": "0.3.2",
	"private": false,
	"description": "The official Astro integration for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./host": {
			"types": "./dist/host.d.mts",
			"default": "./dist/host.mjs"
		},
		"./cli": {
			"types": "./dist/cli.d.mts",
			"default": "./dist/cli.mjs"
		},
		"./toolkit": {
			"types": "./dist/toolkit.d.mts",
			"default": "./dist/toolkit.mjs"
		},
		"./internal/route": {
			"types": "./dist/internal/route.d.mts",
			"default": "./dist/internal/route.mjs"
		},
		"./internal/middleware": {
			"types": "./dist/internal/middleware.d.mts",
			"default": "./dist/internal/middleware.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch",
		"format": "biome format ./src",
		"format:fix": "biome format --write ./src",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/astro"
	},
	"keywords": [
		"CMS",
		"Astro",
		"Lucid CMS",
		"Lucid",
		"Integration"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.13.2",
		"astro": "^7.4.2",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0",
		"astro": "^7.4.0"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
