{
	"name": "@lucidcms/types",
	"version": "0.19.0-alpha.0",
	"private": false,
	"description": "Shared public TypeScript types for Lucid CMS packages.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/types"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Types",
		"TypeScript"
	],
	"devDependencies": {
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"sideEffects": false,
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": ">=20"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
