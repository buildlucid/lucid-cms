{
	"name": "@lucidcms/richtext",
	"version": "0.19.0-alpha.0",
	"private": false,
	"description": "Shared Tiptap extensions and rich text conversion utilities for Lucid CMS.",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser.d.mts",
			"default": "./dist/browser.mjs"
		},
		"./server": {
			"types": "./dist/server.d.mts",
			"default": "./dist/server.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/rich-text"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Rich Text",
		"Tiptap"
	],
	"devDependencies": {
		"linkedom": "^0.18.14",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@lucidcms/types": "0.19.0-alpha.0",
		"@tiptap/core": "^3.32.2",
		"@tiptap/extension-link": "^3.32.2",
		"@tiptap/pm": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"@tiptap/static-renderer": "^3.32.2"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": ">=24"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
