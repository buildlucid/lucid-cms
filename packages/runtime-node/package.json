{
	"name": "@lucidcms/runtime-node",
	"version": "1.2.2",
	"private": false,
	"description": "The official Node runtime for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./entry": {
			"types": "./dist/entry.d.mts",
			"default": "./dist/entry.mjs"
		},
		"./handler": {
			"types": "./dist/handler.d.mts",
			"default": "./dist/handler.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"default": "./dist/vite.mjs"
		},
		"./hosted": {
			"types": "./dist/hosted.d.mts",
			"default": "./dist/hosted.mjs"
		},
		"./types": {
			"types": "./dist/types.d.mts",
			"default": "./dist/types.mjs"
		}
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/runtime-node"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Node",
		"Runtime"
	],
	"devDependencies": {
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"@types/node-cron": "^3.0.11",
		"dotenv": "^18.0.9",
		"node-cron": "^4.6.0"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0",
		"hono": "^4.12.27",
		"hono-openapi": "^1.3.0",
		"vite": "^8.3.5"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
