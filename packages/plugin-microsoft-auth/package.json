{
	"name": "@lucidcms/plugin-microsoft-auth",
	"version": "1.0.6",
	"description": "The official Microsoft authentication provider plugin for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch",
		"format": "biome format ./src",
		"format:fix": "biome format --write ./src",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src"
	},
	"files": [
		"dist",
		"assets"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-microsoft-auth"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Microsoft",
		"Authentication",
		"Provider",
		"Plugin"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
