{
	"name": "@lucidcms/runtime-cloudflare",
	"version": "1.3.1",
	"private": false,
	"description": "The official Cloudflare runtime for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./entry": {
			"types": "./dist/entry.d.mts",
			"default": "./dist/entry.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"default": "./dist/vite.mjs"
		},
		"./config": {
			"types": "./dist/config.d.mts",
			"default": "./dist/config.mjs"
		},
		"./hosted": {
			"types": "./dist/hosted.d.mts",
			"default": "./dist/hosted.mjs"
		},
		"./types": {
			"types": "./dist/types.d.mts",
			"default": "./dist/types.mjs"
		}
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch",
		"format": "biome format ./src",
		"format:fix": "biome format --write ./src",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/runtime-cloudflare"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Cloudflare",
		"Worker",
		"Runtime"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@cloudflare/config": "^0.29.0",
		"@cloudflare/vite-plugin": "^2.0.0-beta.v.8"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0",
		"hono": "^4.12.27",
		"hono-openapi": "^1.3.0",
		"vite": "^8.3.5"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
