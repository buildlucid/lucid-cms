{
	"name": "@lucidcms/cloudflare-queues",
	"version": "0.19.0-alpha.0",
	"description": "The official Cloudflare Queues plugin for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./worker": {
			"types": "./dist/worker.d.mts",
			"default": "./dist/worker.mjs"
		},
		"./translations": "./translations",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist",
		"translations"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-cloudflare-queues"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Cloudflare",
		"Queues",
		"Plugin"
	],
	"devDependencies": {
		"@lucidcms/cloudflare": "0.19.0-alpha.0",
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"@cloudflare/workers-types": "^5.20261030.1"
	},
	"peerDependencies": {
		"@lucidcms/cloudflare": "0.19.0-alpha.0",
		"@lucidcms/core": "0.19.0-alpha.0"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": ">=24"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
