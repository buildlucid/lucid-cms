{
	"name": "@lucidcms/plugin-google-recaptcha",
	"version": "0.1.0",
	"description": "The official Google reCAPTCHA plugin for Lucid CMS",
	"type": "module",
	"types": "./dist/server/index.d.mts",
	"module": "dist/server/index.mjs",
	"exports": {
		".": {
			"types": "./dist/server/index.d.mts",
			"import": "./dist/server/index.mjs"
		},
		"./components": {
			"types": "./dist/admin/components.d.mts",
			"default": "./src/admin/components/index.ts"
		}
	},
	"scripts": {
		"build": "tsc --noEmit && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist/server",
		"dist/admin",
		"src/admin",
		"src/constants.ts",
		"src/types.ts",
		"!src/**/*.test.*"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-google-recaptcha"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Google",
		"reCAPTCHA",
		"Captcha",
		"Plugin"
	],
	"devDependencies": {
		"@lucidcms/admin": "0.19.0-alpha.0",
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"solid-js": "^1.9.18",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@lucidcms/admin": "^0.19.0-alpha.0",
		"@lucidcms/core": "^0.19.0-alpha.0",
		"solid-js": "^1.9.13"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
