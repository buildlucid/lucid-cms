{
	"name": "@lucidcms/core",
	"version": "0.19.0-alpha.0",
	"description": "The core of the Lucid CMS. It's responsible for spinning up the API and serving the CMS.",
	"type": "module",
	"types": "./dist/exports/index.d.mts",
	"module": "dist/exports/index.mjs",
	"exports": {
		".": {
			"types": "./dist/exports/index.d.mts",
			"import": "./dist/exports/index.mjs"
		},
		"./cli": {
			"types": "./dist/libs/cli/index.d.mts",
			"default": "./dist/libs/cli/index.mjs"
		},
		"./build": {
			"types": "./dist/exports/build.d.mts",
			"default": "./dist/exports/build.mjs"
		},
		"./extension": {
			"types": "./dist/exports/extension.d.mts",
			"default": "./dist/exports/extension.mjs"
		},
		"./runtime": {
			"types": "./dist/exports/runtime.d.mts",
			"default": "./dist/exports/runtime.mjs"
		},
		"./toolkit": {
			"types": "./dist/exports/toolkit.d.mts",
			"default": "./dist/exports/toolkit.mjs"
		},
		"./types": {
			"types": "./dist/exports/types.d.mts",
			"default": "./dist/exports/types.mjs"
		},
		"./vite": {
			"types": "./dist/exports/vite.d.mts",
			"default": "./dist/exports/vite.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "NODE_OPTIONS=--max-old-space-size=4096 tsc && tsdown",
		"dev": "tsdown --watch --no-clean"
	},
	"files": [
		"dist",
		"templates",
		"public"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/core"
	},
	"keywords": [
		"CMS",
		"Headless",
		"Node",
		"Typescript",
		"ESM",
		"Hono",
		"Kysely",
		"Cloudflare",
		"Lucid CMS",
		"Lucid"
	],
	"devDependencies": {
		"@types/html-to-text": "^9.0.4",
		"@types/node": "^24.19.2",
		"@types/semver": "^7.8.0",
		"@types/slug": "^5.0.9",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@inquirer/confirm": "^6.3.5",
		"@inquirer/select": "^5.2.8",
		"@lucidcms/admin": "0.19.0-alpha.0",
		"@lucidcms/rich-text": "1.2.0",
		"@lucidcms/types": "^0.6.0",
		"@lucidkiln/core": "^1.7.1",
		"@modelcontextprotocol/server": "^2.4.0",
		"@scalar/hono-api-reference": "^0.12.17",
		"commander": "^15.0.0",
		"croner": "^11.0.0",
		"eventsource-parser": "^4.1.3",
		"file-type": "^22.3.0",
		"hono": "^4.13.14",
		"hono-openapi": "^1.5.0",
		"html-to-text": "^10.0.1",
		"immer": "^11.2.9",
		"ipaddr.js": "^2.5.0",
		"jiti": "^2.7.0",
		"kysely": "0.29.7",
		"mime": "^4.1.2",
		"node-object-hash": "^3.1.1",
		"openapi-types": "^12.1.3",
		"picocolors": "^1.1.1",
		"resolve-pkg-maps": "^1.0.0",
		"semver": "^7.8.5",
		"slug": "^12.0.1",
		"vite": "^8.3.5",
		"zod": "^4.6.6"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"bin": {
		"lucidcms": "dist/libs/cli/index.mjs"
	},
	"sideEffects": false,
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
