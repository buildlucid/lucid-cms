{
	"name": "@lucidcms/plugin-resend",
	"version": "1.1.6",
	"description": "The official Resend plugin for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./translations": "./translations"
	},
	"scripts": {
