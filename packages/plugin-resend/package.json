	"files": [
		"dist/**",
		"translations"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-resend"
	},
	"devDependencies": {
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0"
	},
	"dependencies": {
		"svix": "^2.9.1"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
