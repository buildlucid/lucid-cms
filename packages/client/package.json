{
	"name": "@lucidcms/client",
	"version": "0.19.0-alpha.0",
	"private": false,
	"description": "The official client package for Lucid CMS public integration endpoints.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./preview": {
			"types": "./dist/preview.d.ts",
			"default": "./dist/preview.js"
		},
		"./contract": {
			"types": "./dist/contract.d.ts",
			"default": "./dist/contract.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/client"
	},
	"keywords": [
		"CMS",
		"Client",
		"SDK",
		"Lucid CMS",
		"Lucid",
		"Fetch",
		"Browser"
	],
	"devDependencies": {
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@lucidcms/types": "0.19.0-alpha.0"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": ">=20"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
