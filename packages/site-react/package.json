{
	"name": "@lucidcms/site-react",
	"version": "0.0.0",
	"private": true,
	"description": "Renders React components from the Lucid CMS site plugin's Kiln templates.",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./server": "./dist/server.mjs",
		"./client": "./dist/client.mjs",
		"./vite": "./dist/vite.mjs"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch",
		"format": "biome format ./src",
		"format:fix": "biome format --write ./src",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src"
	},
	"files": [
		"dist"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/site-react"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Site",
		"Kiln",
		"React"
	],
	"dependencies": {
		"@vitejs/plugin-react": "^6.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@lucidcms/plugin-site": "*",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@lucidcms/plugin-site": "*",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"license": "MIT"
}
