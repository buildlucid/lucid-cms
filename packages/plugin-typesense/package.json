{
	"name": "@lucidcms/plugin-typesense",
	"version": "0.1.0",
	"description": "The official Typesense content-indexing plugin for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./translations": "./translations"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"dev": "tsdown --watch",
		"test:types": "tsc -p tests/tsconfig.json",
		"format": "biome format ./src",
		"format:fix": "biome format --write ./src",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src"
	},
	"files": [
		"dist",
		"translations"
	],
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-cms.git",
		"directory": "packages/plugin-typesense"
	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Typesense",
		"Search",
		"Plugin"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.13.2",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3",
		"zod": "^4.4.3",
		"@lucidcms/db-sqlite": "1.2.2"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0"
	},
	"dependencies": {
		"typesense": "^3.0.6",
		"kysely": "0.29.2"
	},
	"volta": {
		"node": "24.11.1"
	},
	"engines": {
		"node": "^24.0.0"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
