	},
	"keywords": [
		"CMS",
		"Lucid CMS",
		"Lucid",
		"Sharp",
		"Plugin"
	],
	"devDependencies": {
		"@lucidcms/core": "0.19.0-alpha.0",
		"@types/node": "^24.19.2",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@lucidcms/core": "^0.19.0-alpha.0"
	},
	"dependencies": {
		"mime": "^4.1.2",
		"sharp": "^0.35.5"
	},
