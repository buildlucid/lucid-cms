{
	"name": "@lucidcms/plugin-sharp",
	"version": "1.4.0",
	"private": false,
	"description": "The official Sharp image processing plugin for Lucid CMS",
	"type": "module",
	"types": "./dist/index.d.mts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./translations": "./translations"
	},
	"scripts": {
