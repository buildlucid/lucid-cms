{% props title: string, paragraphs = [], rows = [] %}
<mjml>
  <mj-head>
    <mj-title>{{ title }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-body background-color="#0A0A0A" />
      <mj-section padding="0" />
      <mj-text color="#a1a1a1" font-size="16px" line-height="24px" padding="0" />
    </mj-attributes>
    <mj-style>
      .answer {
        white-space: pre-wrap;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0A0A0A">
    <mj-section padding="20px 0"></mj-section>
    <mj-section background-color="#0F0F0F" border-radius="12px" padding="40px 30px">
      <mj-column width="100%">
        <mj-text color="#F1F1F1" font-size="24px" font-weight="600" padding-bottom="16px">
          {{ title }}
        </mj-text>
        <mj-raw>{% for paragraph in paragraphs %}</mj-raw>
        <mj-text css-class="answer" padding-bottom="16px">
          {{ paragraph }}
        </mj-text>
        <mj-raw>{% endfor %}</mj-raw>
        <mj-raw>{% for row in rows %}</mj-raw>
        <mj-divider border-color="rgba(255, 255, 255, 0.1)" border-width="1px" padding="8px 0 16px 0" />
        <mj-text font-size="13px" font-weight="600" color="#6b6b6b" padding-bottom="4px">
          {{ row.label }}
        </mj-text>
        <mj-text css-class="answer" color="#F1F1F1">
          {{ row.value }}
        </mj-text>
        <mj-raw>{% endfor %}</mj-raw>
      </mj-column>
    </mj-section>
    <mj-raw>{% if context.brand.name %}</mj-raw>
    <mj-section padding="24px 0 40px 0">
      <mj-column width="100%">
        <mj-text font-size="13px" color="#6b6b6b" align="center">
          Sent from {{ context.brand.name }}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-raw>{% endif %}</mj-raw>
  </mj-body>
</mjml>
