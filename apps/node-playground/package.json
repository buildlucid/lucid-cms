{
	"name": "@lucidcms/node-playground",
	"private": true,
	"description": "Internal Node playground used for Lucid CMS testing.",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"dev": "lucidcms dev",
		"serve": "lucidcms serve",
		"build": "lucidcms build",
		"typegen": "lucidcms typegen",
		"start": "lucidcms build && node dist/server.js",
		"sync": "lucidcms sync",
		"migrate": "lucidcms migrate",
		"migrate:new": "lucidcms migrate:new",
		"migrate:status": "lucidcms migrate:status",
		"migrate:rollback": "lucidcms migrate:rollback",
		"migrate:reset": "lucidcms migrate:reset",
		"migrate:fresh": "lucidcms migrate:fresh",
		"seed": "lucidcms seed",
		"seed:new": "lucidcms seed:new",
		"seed:list": "lucidcms seed:list",
		"wrangler:dev": "wrangler --env dev dev --test-scheduled",
		"wrangler:deploy": "npm run build && wrangler --env prod deploy",
		"job:delete-expired-data": "lucidcms jobs:schedule core:delete-expired-data",
		"job:check-system-alerts": "lucidcms jobs:schedule core:check-system-alerts"
	},
	"dependencies": {
		"@lucidcms/plugin-github-auth": "*",
		"@lucidcms/plugin-google-auth": "*",
		"@lucidcms/plugin-microsoft-auth": "*",
		"@lucidcms/runtime-cloudflare": "*",
		"@lucidcms/core": "*",
		"@lucidcms/db-libsql": "*",
		"@lucidcms/runtime-node": "*",
		"@lucidcms/plugin-cloudflare-kv": "*",
		"@lucidcms/plugin-cloudflare-queues": "*",
		"@lucidcms/plugin-filesystem": "*",
		"@lucidcms/plugin-nodemailer": "*",
		"@lucidcms/plugin-pages": "*",
		"@lucidcms/plugin-redirects": "*",
		"@lucidcms/plugin-redis": "*",
		"@lucidcms/plugin-resend": "*",
		"@lucidcms/plugin-s3": "*",
		"@lucidcms/plugin-sharp": "*",
		"@lucidcms/db-postgres": "*",
		"@lucidcms/db-sqlite": "*",
		"@lucidcms/plugin-worker-queues": "*",
		"nodemailer": "^9.0.1",
		"@lucidcms/plugin-typesense": "*"
	},
	"author": "Build Lucid Ltd",
	"license": "MIT",
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"typescript": "^6.0.3",
		"@lucidcms/admin": "*",
		"solid-js": "^1.9.13",
		"tailwindcss": "^4.3.1",
		"@tanstack/solid-query": "^5.101.1"
	},
	"volta": {
		"node": "24.11.1"
	},
	"engines": {
		"node": "^24.0.0"
	}
}
