{
	"root": ".",
	"strict": true,
	"functions": [
		"document",
		"documentList",
		"documentPaths",
		"editable",
		"footer",
		"head",
		"locales",
		"media",
		"mediaList",
		"mediaUrl",
		"notFound",
		"pageGreeting",
		"redirect",
		"richText",
		"translate",
		"vite",
		"viteAsset"
	],
	"filters": [],
	"tests": [],
	"globals": [
		"locale"
	],
	"types": [
		"Brick",
		"Document",
		"Media",
		"RichText"
	],
	"htmlChecks": true,
	"components": [
		{
			"extensions": [
				".jsx",
				".tsx"
			],
			"exclude": [
				"components/solid/**"
			],
			"props": "(import(\"react\").ComponentProps<typeof import($file).default>) & { client?: \"load\" | \"idle\" | \"visible\" | \"only\" | { media: string } }"
		},
		{
			"extensions": [
				".jsx",
				".tsx"
			],
			"include": [
				"components/solid/**"
			],
			"props": "(Parameters<typeof import($file).default>[0]) & { client?: \"load\" | \"idle\" | \"visible\" | \"only\" | { media: string } }"
		},
		{
			"extensions": [
				".vue"
			],
			"props": "{ client?: \"load\" | \"idle\" | \"visible\" | \"only\" | { media: string } }"
		},
		{
			"extensions": [
				".svelte"
			],
			"props": "{ client?: \"load\" | \"idle\" | \"visible\" | \"only\" | { media: string } }"
		}
	]
}
