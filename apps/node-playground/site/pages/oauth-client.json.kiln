{# OAuth client metadata whose URL is the lab's client ID. #}
{{ {
	client_id: siteUrl ~ "/oauth-client.json",
	client_name: "Lucid Playground",
	...(siteUrl starts with "https:" ? { client_uri: siteUrl } : {}),
	redirect_uris: locales()|map(item => siteUrl ~ "/" ~ item.code ~ "/lab/integrations"),
	grant_types: ["authorization_code", "refresh_token"],
	response_types: ["code"],
	token_endpoint_auth_method: "none",
}|json(2)|raw }}
