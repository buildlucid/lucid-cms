{% extends "layouts/base" %}

{% export paths = documentPaths("page") %}

{% set page = document("page", {
	filter: { _fullSlug: route.path },
	include: ["bricks", "refs.media", "refs.documents"],
}) ?? notFound() %}
{% set media = mediaList({ filter: { type: 'image' } }) %}
{% set lang = page.locale %}

{% block title %}{{ page.fields.page_title }} | Playground{% endblock %}

{% block content %}
	{% component "components/card" with { title: page.fields.page_title, editable: editable(page, "page_title") } %}
		{% fill "meta" %}<a href="{{ page.url }}">{{ page.url }}</a>{% endfill %}
		<p>Document {{ page.id }}, rendered in {{ page.locale }}.</p>
		<p>{{ pageGreeting("Will") }}</p>
	{% endcomponent %}

	{% for brick in page.bricks %}
		{% include "sections/" ~ brick.key with { brick: brick } %}
	{% endfor %}

	{% island "islands/latest-pages" with { locale: page.locale } %}
		<p>Loading the latest pages…</p>
	{% endisland %}

	{% for item in media.items %}
		<figure class="media-figure">
			<img {{ attrs({ src: item.url, alt: item.alt, width: item?.width, height: item?.height, loading: "lazy" }) }}>
			{% if item.title %}<figcaption>{{ item.title }}</figcaption>{% endif %}
		</figure>
	{% endfor %}
{% endblock %}
