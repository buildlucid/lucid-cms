{% extends "layouts/base" %}

{% export paths = documentPaths("page") %}

{% set page = document("page", {
	filter: { _fullSlug: route.path },
	include: ["bricks"],
}) ?? notFound() %}
{% set alternates = page.route?.alternates %}

{% block title %}{{ page.fields.page_title }} | {{ parent() }}{% endblock %}

{% block content %}
	<h1 {{ editable(page, "page_title") }}>{{ page.fields.page_title }}</h1>

	{% for brick in page.bricks %}
		{% include "bricks/" ~ brick.key with { brick: brick } %}
	{% endfor %}
{% endblock %}
