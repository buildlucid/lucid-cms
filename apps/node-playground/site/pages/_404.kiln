{% extends "layouts/base" %}

{% set alternates = {} %}

{% block title %}{{ translate("notFound.title") }} | {{ parent() }}{% endblock %}

{% block content %}
	<h1>{{ translate("notFound.title") }}</h1>
	<p>{{ translate("notFound.body", { data: { path: route.path } }) }}</p>
	<p><a href="/{{ locale }}">{{ translate("notFound.home") }}</a></p>
{% endblock %}
