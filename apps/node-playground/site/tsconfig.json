{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["vite/client"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["**/*", "../.lucid/types.d.ts"],
	"exclude": ["ui/solid"]
}
