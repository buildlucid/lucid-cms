{% props brick: Brick %}

<section class="intro">
	<h2 {{ editable(brick, "title") }}>{{ brick.fields.title }}</h2>
	{% include "components/rich-text" with { node: brick.fields.intro } %}

	{% if brick.fields.intro_audio|first?.url %}
		<audio controls src="{{ brick.fields.intro_audio|first.url }}"></audio>
	{% endif %}
</section>
