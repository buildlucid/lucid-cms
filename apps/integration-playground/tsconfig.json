{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client", "node"]
	},
	"include": ["src", "vite.config.ts"]
}
