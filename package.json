{
	"private": true,
	"scripts": {
		"start": "turbo run start",
		"build": "turbo run build",
		"dev:full": "turbo dev --filter=@lucidcms/node-playground --filter=@lucidcms/admin --filter=@lucidcms/core",
		"dev:core": "turbo dev --filter=@lucidcms/node-playground --filter=@lucidcms/core",
		"dev:cms": "turbo dev --filter=@lucidcms/node-playground --filter=@lucidcms/admin",
		"test": "vitest run --test-timeout=0 --hook-timeout=0 --silent",
		"test:watch": "vitest watch --test-timeout=0 --hook-timeout=0",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "oxfmt --check && oxlint && turbo run check",
		"check:fix": "oxfmt && oxlint --fix",
		"fallow": "fallow --workspace \"@lucidcms/*,!@lucidcms/*playground\" --score",
		"fallow:audit": "fallow audit --workspace \"@lucidcms/*,!@lucidcms/*playground\"",
		"fallow:type-aware": "fallow dead-code --workspace \"@lucidcms/*,!@lucidcms/*playground\" --type-aware",
		"prepare": "husky"
	},
	"devDependencies": {
		"fallow": "^3.37.0",
		"husky": "^9.1.7",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"turbo": "^2.11.10",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"name": "lucid",
	"packageManager": "npm@11.20.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"volta": {
		"node": "26.12.1"
	},
	"engines": {
		"node": "^24.0.0 || ^26.0.0"
	},
	"author": "Build Lucid Ltd",
	"license": "MIT",
	"allowScripts": {
		"better-sqlite3": true,
		"workerd": true,
		"sharp": true,
		"fsevents": false
	},
	"overrides": {
		"kysely-postgres-js": {
			"postgres": "^4.0.0"
		}
	}
}
